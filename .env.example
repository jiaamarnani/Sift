# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is committed.
# Only DATABASE_URL and REDIS_URL are needed for phases 1-4.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Infrastructure (ports match docker-compose.yml) ---
DATABASE_URL=postgres://sifter:sifter@localhost:5433/sifter
REDIS_URL=redis://localhost:6380

# --- LLM scoring (phase 3) ---
# Which backend scores email: "gemini" (hosted) or "ollama" (local).
LLM_PROVIDER=gemini
# Max outbound scoring calls per minute (client-side rate limit)
LLM_RATE_LIMIT_PER_MIN=5
LLM_TIMEOUT_MS=60000

# Gemini: key from https://aistudio.google.com/apikey
# Note: on the free tier Google may use prompts to improve its products, so
# real email content goes to Google under those terms.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ollama: `ollama pull llama3.1:8b` first. Nothing leaves the machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Gmail OAuth (phase 5) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (type: Web application). Scopes: gmail.readonly + gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback
# Populated by the one-time consent flow in phase 5
GOOGLE_REFRESH_TOKEN=
# The inbox being triaged; also the digest recipient
GMAIL_USER_EMAIL=you@example.com

# --- Telegram (phase 6) ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat id (message @userinfobot to get it)
TELEGRAM_CHAT_ID=
# Random string you generate; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
# so the webhook can reject forged requests. e.g. `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=

# --- Scheduling ---
# How often the poller runs (default: every 15 minutes)
POLL_CRON=*/15 * * * *
# IANA timezone used for the digest send time stored in user_criteria
TIMEZONE=America/New_York

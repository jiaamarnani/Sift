{
  "name": "sifter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI inbox triage service: polls Gmail, filters junk with rules, scores with an LLM (Gemini or Ollama), notifies via Telegram + daily digest.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/worker/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run -c vitest.integration.config.ts",
    "test:live": "LIVE_LLM=1 vitest run tests/live --bail 1",
    "demo": "tsx src/demo/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.0",
    "googleapis": "^182.0.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
